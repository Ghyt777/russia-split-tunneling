{
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "domain:youtube.com",
          "domain:youtu.be",
          "domain:youtube-nocookie.com",
          "domain:ytimg.com",
          "domain:googlevideo.com",
          "domain:ggpht.com",
          "domain:youtubei.googleapis.com",
          "domain:instagram.com",
          "domain:cdninstagram.com",
          "domain:facebook.com",
          "domain:facebook.net",
          "domain:fb.com",
          "domain:fbcdn.net",
          "domain:fbsbx.com",
          "domain:x.com",
          "domain:twitter.com",
          "domain:twimg.com",
          "domain:t.co",
          "domain:discord.com",
          "domain:discord.gg",
          "domain:discordapp.com",
          "domain:discordapp.net",
          "domain:discord.media",
          "domain:whatsapp.com",
          "domain:whatsapp.net",
          "domain:wa.me",
          "domain:viber.com",
          "domain:signal.org",
          "domain:whispersystems.org",
          "domain:linkedin.com",
          "domain:licdn.com",
          "domain:telegram.org",
          "domain:t.me",
          "domain:telegram.me"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "domain": [
          "domain:vk.com",
          "domain:vk.me",
          "domain:userapi.com",
          "domain:yandex.net",
          "domain:yandex.com",
          "domain:yastatic.net",
          "domain:sberbank.com",
          "regexp:\\.ru$",
          "regexp:\\.su$",
          "regexp:\\.xn\\-\\-p1ai$"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": [
          "geoip:ru"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  }
}